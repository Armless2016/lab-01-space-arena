{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "shared/**/*.ts",
    "server/src/**/*.ts",
    "client/src/main.ts",
    "client/src/network-game.ts",
    "client/src/socket-client.ts",
    "client/src/asset-loader.ts",
    "client/src/audio.ts",
    "client/src/event-bus.ts",
    "client/src/hud.ts",
    "client/src/lobby.ts",
    "client/src/lobby-view.ts",
    "client/src/render.ts",
    "client/src/diagnostics.ts",
    "client/src/microtask-puzzles.ts",
    "client/vite.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
