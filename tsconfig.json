{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "shared/**/*.ts",
    "client/src/main.ts",
    "client/src/loop.ts",
    "client/src/performance-monitor.ts",
    "client/src/worker-experiment.ts",
    "client/src/workers/**/*.ts",
    "client/tests/**/*.ts",
    "client/vite.config.ts",
    "server/src/**/*.ts",
    "server/tests/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "server/bench/**"
  ]
}
