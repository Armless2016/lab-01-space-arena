{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "..",
    "paths": {
      "@space-arena/shared": [
        "shared/dist/index.d.ts"
      ],
      "@space-arena/shared/*": [
        "shared/dist/*.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
