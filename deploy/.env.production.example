# Copy to .env on the deployment host; never commit a real production .env.
APP_DOMAIN=arena.example.com
GHCR_IMAGE=ghcr.io/OWNER/REPOSITORY
IMAGE_TAG=v1.0.0
BUILD_SHA=replace-with-release-commit-sha
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://arena.example.com
ALLOW_MISSING_ORIGIN=false
TRUST_PROXY=true
MAX_CONNECTIONS_PER_IP=32
MAX_ROOMS=100
MAX_PLAYERS_PER_ROOM=16
MAX_MESSAGES_PER_SECOND=120
WS_MAX_PAYLOAD=16384
LOG_LEVEL=info
