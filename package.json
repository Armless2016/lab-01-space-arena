{
  "name": "space-arena-monorepo",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "bench:memory": "node server/bench/rss-backpressure.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "globals": "latest"
  }
}
